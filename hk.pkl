amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["ansible-syntax"] {
    check = "ansible-playbook --syntax-check site.yaml"
  }
  ["yamllint"] = Builtins.yamllint
  ["shell-syntax"] {
    types = List("bash", "sh")
    check = "bash -n {{files}}"
  }
  ["python-syntax"] {
    types = List("python")
    check = #"python3 -c 'import pathlib, sys; [compile(pathlib.Path(file).read_text(), file, "exec") for file in sys.argv[1:]]' {{files}}"#
  }
  ["zsh-syntax"] {
    glob = "**/*.zsh"
    check = "zsh -n {{files}}"
  }
  ["gitleaks"] = Builtins.gitleaks
}

hooks {
  ["pre-commit"] { steps = checks }
  ["check"] { steps = checks }
}
