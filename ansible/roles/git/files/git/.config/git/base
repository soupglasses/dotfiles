# vi: ft=gitconfig
[core]
    fsMonitor = true
    untrackedCache = true

# Credential storage is platform-specific and lives in credential-linux /
# credential-darwin, included from config by the git role.

# Always talk to forges over ssh, even when something hands us an https URL
# (a README, `go get`, a tool that only knows the https form). Pushing over
# https would prompt for a token; ssh just uses the agent.
#
# This applies to reading public repositories too, so every forge here needs a
# working key in the agent.
[url "git@github.com:"]
    insteadOf = https://github.com/
[url "git@gitlab.com:"]
    insteadOf = https://gitlab.com/
[url "git@codeberg.org:"]
    insteadOf = https://codeberg.org/

[color]
    ui = auto

[column]
    ui = auto

[init]
    defaultBranch = main

[fetch]
    writeCommitGraph = true

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[branch]
    sort = -committerdate

[rerere]
    enabled = true

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[log]
    showSignature = true

[merge]
    conflictstyle = diff3
    tool = nvimdiff

[diff]
    colorMoved = default

[blame]
    coloring = highlightRecent
    date = relative
