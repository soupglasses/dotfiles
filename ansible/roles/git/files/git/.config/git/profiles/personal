# vi: ft=gitconfig
[user]
    email = sofie+git@finnes.dev
    name = Sofie Finnes
    signingKey = 516522D0036CD9F1
    useConfigOnly = true

[commit]
    gpgSign = true

[tag]
    gpgSign = true

# A machine-local default may use SSH signing; restore OpenPGP with the rest of
# the personal identity.
[gpg]
    format = openpgp

# Use the personal OpenPGP authentication subkey through gpg-agent. The .pub
# file is only a public-key hint for signatures; passing it as IdentityFile
# makes OpenSSH try to load a public key as a private key. This file is included
# unconditionally, so it sets the default; a work include overrides it in work
# contexts. Self-contained (-F /dev/null) so a work key pinned to github.com in
# ~/.ssh/config cannot leak in and authenticate as the wrong account.
[core]
    sshCommand = ssh -F /dev/null -o IdentitiesOnly=no -o IdentityAgent=~/.gnupg/S.gpg-agent.ssh -o UserKnownHostsFile=~/.ssh/known_hosts

[sendemail]
    smtpserver = msmtp
    smtpserveroption = --account git
    annotate = yes
