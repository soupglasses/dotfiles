#!/usr/bin/env python3
"""Add files to GNOME's recently used list."""

import argparse
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")

from gi.repository import Gio, GLib, Gtk


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", nargs="+", type=Path, help="file to add")
    parser.add_argument(
        "--app-name",
        help="application name recorded by GTK (defaults to this command's name)",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    GLib.set_application_name(args.app_name or Path(sys.argv[0]).name)

    manager = Gtk.RecentManager.get_default()
    missing = False

    for path in args.file:
        file = Gio.File.new_for_path(str(path.expanduser()))
        if not file.query_exists():
            print(f"gnome-recent-add: file does not exist: {path}", file=sys.stderr)
            missing = True
            continue
        manager.add_item(file.get_uri())

    # GtkRecentManager updates asynchronously; let its queued writes complete.
    GLib.idle_add(Gtk.main_quit)
    Gtk.main()
    return 1 if missing else 0


if __name__ == "__main__":
    raise SystemExit(main())
